;;; slidepilot-movie-tests.el --- Movie insertion checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'slidepilot-movie)

(ert-deftest slidepilot-movie-inserts-relative-paths-and-preserves-sizing ()
  (let* ((directory (make-temp-file "slidepilot-test-" t))
         (movie (expand-file-name "a movie.mp4" directory)))
    (unwind-protect
        (progn
          (write-region "movie" nil movie nil 'silent)
          (with-temp-buffer
            (setq buffer-file-name (expand-file-name "slides.tex" directory))
            (cl-letf (((symbol-function 'executable-find) (lambda (_) t))
                      ((symbol-function 'call-process)
                       (lambda (&rest args)
                         (should (member movie args))
                         (write-region "poster" nil (car (last args)) nil 'silent)
                         0)))
              (slidepilot-insert-movie movie))
            (should (string-match-p (regexp-quote "\\detokenize{a movie.mp4}") (buffer-string)))
            (should (string-match-p "keepaspectratio" (buffer-string)))
            (should-not (string-match-p "autostart" (buffer-string)))
            (should (file-exists-p (expand-file-name "a movie-poster.png" directory)))))
      (delete-directory directory t))))

(ert-deftest slidepilot-movie-autostart-and-loop-add-options ()
  (let* ((directory (make-temp-file "slidepilot-test-" t))
         (movie (expand-file-name "movie.mp4" directory)))
    (unwind-protect
        (progn
          (write-region "movie" nil movie nil 'silent)
          (with-temp-buffer
            (setq buffer-file-name (expand-file-name "slides.tex" directory))
            (cl-letf (((symbol-function 'executable-find) (lambda (_) t))
                      ((symbol-function 'y-or-n-p) (lambda (_) t))
                      ((symbol-function 'call-process)
                       (lambda (&rest args)
                         (write-region "poster" nil (car (last args)) nil 'silent)
                         0)))
              (slidepilot-insert-movie movie t)
              (slidepilot-insert-movie movie nil t)
              (slidepilot-insert-movie movie t t))
            (should (string-match-p (regexp-quote "\\movie[autostart]\n") (buffer-string)))
            (should (string-match-p (regexp-quote "\\movie[loop]\n") (buffer-string)))
            (should (string-match-p (regexp-quote "\\movie[autostart,loop]\n") (buffer-string)))))
      (delete-directory directory t))))

(ert-deftest slidepilot-movie-failure-leaves-buffer-unchanged ()
  (let* ((directory (make-temp-file "slidepilot-test-" t))
         (movie (expand-file-name "movie.mp4" directory)))
    (unwind-protect
        (progn
          (write-region "movie" nil movie nil 'silent)
          (with-temp-buffer
            (setq buffer-file-name (expand-file-name "slides.tex" directory))
            (insert "original")
            (cl-letf (((symbol-function 'executable-find) (lambda (_) t))
                      ((symbol-function 'call-process) (lambda (&rest _) 1)))
              (should-error (slidepilot-insert-movie movie) :type 'user-error))
            (should (equal (buffer-string) "original"))
            (should-not (file-exists-p (expand-file-name "movie-poster.png" directory)))))
      (delete-directory directory t))))

(ert-deftest slidepilot-movie-url-youtube-uses-thumbnail-poster ()
  (let ((directory (make-temp-file "slidepilot-test-" t)))
    (unwind-protect
        (with-temp-buffer
          (setq buffer-file-name (expand-file-name "slides.tex" directory))
          (cl-letf (((symbol-function 'call-process) (lambda (&rest _) (error "FFmpeg not needed")))
                    ((symbol-function 'url-copy-file)
                     (lambda (url file &rest _)
                       (should (equal url "https://img.youtube.com/vi/P25BwtepmUk/hqdefault.jpg"))
                       (write-region "poster" nil file nil 'silent))))
            (slidepilot-insert-movie-url "https://www.youtube.com/watch?v=P25BwtepmUk" t t))
          (should (string-match-p (regexp-quote "\\movie[autostart,loop]\n") (buffer-string)))
          (should (string-match-p (regexp-quote "{\\detokenize{P25BwtepmUk-poster.jpg}}") (buffer-string)))
          (should (string-match-p (regexp-quote "{\\detokenize{https://www.youtube.com/watch?v=P25BwtepmUk}}")
                                  (buffer-string)))
          (should (file-exists-p (expand-file-name "P25BwtepmUk-poster.jpg" directory))))
      (delete-directory directory t))))

(ert-deftest slidepilot-movie-url-file-escapes-and-uses-ffmpeg ()
  (let ((directory (make-temp-file "slidepilot-test-" t))
        (url "https://example.com/clips/a%20b.mp4#t=1"))
    (unwind-protect
        (with-temp-buffer
          (setq buffer-file-name (expand-file-name "slides.tex" directory))
          (cl-letf (((symbol-function 'executable-find) (lambda (_) t))
                    ((symbol-function 'call-process)
                     (lambda (&rest args)
                       (should (member url args))
                       (write-region "poster" nil (car (last args)) nil 'silent)
                       0)))
            (slidepilot-insert-movie-url url))
          (should (string-match-p (regexp-quote "{\\detokenize{https://example.com/clips/a\\04520b.mp4\\043t=1}}")
                                  (buffer-string)))
          (should (file-exists-p (expand-file-name "a-b-poster.png" directory))))
      (delete-directory directory t))))

(ert-deftest slidepilot-movie-url-rejects-non-web-addresses ()
  (with-temp-buffer
    (setq buffer-file-name "/tmp/slides.tex")
    (insert "original")
    (should-error (slidepilot-insert-movie-url "ftp://example.com/movie.mp4") :type 'user-error)
    (should-error (slidepilot-insert-movie-url "https://example.com/a movie.mp4") :type 'user-error)
    (should (equal (buffer-string) "original"))))

(ert-deftest slidepilot-movie-youtube-ids ()
  (dolist (url '("https://youtu.be/P25BwtepmUk" "https://m.youtube.com/watch?feature=share&v=P25BwtepmUk"
                 "https://www.youtube.com/embed/P25BwtepmUk?start=3" "https://youtube.com/shorts/P25BwtepmUk"))
    (should (equal (slidepilot-movie--youtube-id url) "P25BwtepmUk")))
  (should-not (slidepilot-movie--youtube-id "https://example.com/watch?v=P25BwtepmUk")))

(ert-deftest slidepilot-webpage-snapshots-url-and-escapes-it ()
  (let ((directory (make-temp-file "slidepilot-test-" t))
        (url "https://www.example.com/docs/a_b?q=x%20y&s={1}#top"))
    (unwind-protect
        (with-temp-buffer
          (setq buffer-file-name (expand-file-name "slides.tex" directory))
          (cl-letf (((symbol-function 'executable-find) (lambda (_) t))
                    ((symbol-function 'file-readable-p) (lambda (_) t))
                    ((symbol-function 'call-process)
                     (lambda (program &rest args)
                       (should (equal program slidepilot-webpage-swift-program))
                       (should (member url args))
                       (should (equal (last args 2) '("1024" "640")))
                       (write-region "poster" nil (nth 5 args) nil 'silent)
                       0)))
            (slidepilot-insert-web-page url))
          (should (string-match-p (regexp-quote "\\webpage\n") (buffer-string)))
          (should (string-match-p (regexp-quote "{\\detokenize{example-com-docs-a-b-poster.png}}") (buffer-string)))
          (should (string-match-p (regexp-quote "{https://www.example.com/docs/a_b?q=x\\%20y&s=\\%7B1\\%7D\\#top}")
                                  (buffer-string)))
          (should (file-exists-p (expand-file-name "example-com-docs-a-b-poster.png" directory))))
      (delete-directory directory t))))

(ert-deftest slidepilot-webpage-local-file-and-page-width ()
  (let* ((directory (make-temp-file "slidepilot-test-" t))
         (page (expand-file-name "demo/my page.html" directory))
         (slidepilot-webpage-size '(1280 . 720)))
    (unwind-protect
        (progn
          (make-directory (file-name-directory page))
          (write-region "<p>hi</p>" nil page nil 'silent)
          (with-temp-buffer
            (setq buffer-file-name (expand-file-name "slides.tex" directory))
            (cl-letf (((symbol-function 'executable-find) (lambda (_) t))
                      ((symbol-function 'file-readable-p) (lambda (_) t))
                      ((symbol-function 'call-process)
                       (lambda (_program &rest args)
                         (should (member page args))
                         (should (equal (last args 2) '("1280" "720")))
                         (write-region "poster" nil (nth 5 args) nil 'silent)
                         0)))
              (slidepilot-insert-web-page "demo/my page.html"))
            (should (string-match-p (regexp-quote "\\webpage[pagewidth=1280]\n") (buffer-string)))
            (should (string-match-p (regexp-quote "{\\detokenize{demo/my page-poster.png}}") (buffer-string)))
            (should (string-match-p (regexp-quote "\n    {demo/my page.html}\n") (buffer-string)))))
      (delete-directory directory t))))

(ert-deftest slidepilot-webpage-failure-leaves-buffer-unchanged ()
  (let ((directory (make-temp-file "slidepilot-test-" t)))
    (unwind-protect
        (with-temp-buffer
          (setq buffer-file-name (expand-file-name "slides.tex" directory))
          (insert "original")
          (cl-letf (((symbol-function 'executable-find) (lambda (_) t))
                    ((symbol-function 'file-readable-p) (lambda (_) t))
                    ((symbol-function 'call-process) (lambda (&rest _) (insert "offline") 1)))
            (should-error (slidepilot-insert-web-page "https://example.com") :type 'user-error))
          (should-error (slidepilot-insert-web-page "missing.html") :type 'user-error)
          (should-error (slidepilot-insert-web-page "https://example.com/a b") :type 'user-error)
          (should (equal (buffer-string) "original"))
          (should-not (file-exists-p (expand-file-name "example-com-poster.png" directory))))
      (delete-directory directory t))))

(ert-deftest slidepilot-movie-fullscreen-covers-slide ()
  (let* ((directory (make-temp-file "slidepilot-test-" t))
         (movie (expand-file-name "movie.mp4" directory)))
    (unwind-protect
        (progn
          (write-region "movie" nil movie nil 'silent)
          (with-temp-buffer
            (setq buffer-file-name (expand-file-name "slides.tex" directory))
            (cl-letf (((symbol-function 'executable-find) (lambda (_) t))
                      ((symbol-function 'url-copy-file)
                       (lambda (_url file &rest _) (write-region "poster" nil file nil 'silent)))
                      ((symbol-function 'call-process)
                       (lambda (&rest args)
                         (write-region "poster" nil (car (last args)) nil 'silent)
                         0)))
              (slidepilot-insert-movie movie t t t)
              (slidepilot-insert-movie-url "https://youtu.be/P25BwtepmUk" nil nil t))
            (should (string-match-p
                     (regexp-quote "\n\\movie[autostart,loop,fullscreen]\n  {\\includegraphics[width=\\paperwidth,height=\\paperheight,keepaspectratio]{\\detokenize{movie-poster.png}}}\n  {\\detokenize{movie.mp4}}\n")
                     (buffer-string)))
            (should (string-match-p (regexp-quote "\\movie[fullscreen]\n") (buffer-string)))
            (should-not (string-match-p "center" (buffer-string)))))
      (delete-directory directory t))))

(ert-deftest slidepilot-webpage-fullscreen-uses-slide-shape ()
  (let ((directory (make-temp-file "slidepilot-test-" t))
        sizes)
    (unwind-protect
        (with-temp-buffer
          (setq buffer-file-name (expand-file-name "slides.tex" directory))
          (insert "\\documentclass[11pt,aspectratio=169]{beamer}\n")
          (cl-letf (((symbol-function 'executable-find) (lambda (_) t))
                    ((symbol-function 'file-readable-p) (lambda (_) t))
                    ((symbol-function 'y-or-n-p) (lambda (_) t))
                    ((symbol-function 'call-process)
                     (lambda (_program &rest args)
                       (push (last args 2) sizes)
                       (write-region "poster" nil (nth 5 args) nil 'silent)
                       0)))
            (slidepilot-insert-web-page "https://example.com/a" t)
            (slidepilot-insert-web-page "https://example.com/b")
            (goto-char (point-min))
            (replace-regexp "aspectratio=169" "aspectratio=43")
            (goto-char (point-max))
            (let ((current-prefix-arg '(4)))
              (call-interactively
               (lambda () (interactive) (apply #'slidepilot-insert-web-page
                                               (list "https://example.com/c"
                                                     (y-or-n-p "Cover the whole slide? ")))))))
          (should (equal (reverse sizes) '(("1024" "576") ("1024" "640") ("1024" "768"))))
          (should (string-match-p
                   (regexp-quote "\n\\webpage[fullscreen]\n  {\\includegraphics[width=\\paperwidth,height=\\paperheight,keepaspectratio]{\\detokenize{example-com-a-poster.png}}}\n  {https://example.com/a}\n")
                   (buffer-string)))
          (should (string-match-p (regexp-quote "\\begin{center}\n  \\webpage\n") (buffer-string))))
      (delete-directory directory t))))
